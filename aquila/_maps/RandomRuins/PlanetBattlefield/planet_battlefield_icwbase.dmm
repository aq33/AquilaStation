"wm" = (
/obj/structure/bed/double,
/obj/item/bedsheet/double/grey,
/obj/item/paper/crumpled/bloody{
	pixel_x = 8;
	pixel_y = -4;
	name = "strona dziennika";
	default_raw_text = "Zegarek się zepsuł. Jest środa, Kit, a ty pewnie wiesz, który mamy rok, i wiem, że czytasz mój pieprzony dziennik. Siedzimy tu od trzech tygodni. Zaczynam myśleć, że ta kryjówka naprawdę się sprawdzi. Gdy zobaczyłem, na jakich planetach można się na szybko schować, przyczajenie się tutaj wybrałem zamiast palnięcia sobie w łeb, ale to miejsce coraz bardziej mi się podoba. Omar myśli, że możemy je urządzić od nowa. Wywalić korporacyjne graty i wstawić coś naprawdę ładnego. Wielki dysk Auhkry-Dux pełen pirackich filmów i seriali dalej działa, a ona obiecała uruchomić któryś ze starych ekranów, żebyśmy mieli wieczory filmowe jak za dawnych czasów. Robię listę mebli do zwinięcia i wstawienia tutaj. A ty się wal, Kit. Masz szczęście, że przy takim wścibstwie dalej śpisz w moim łóżku. Też cię kocham."
	},
/obj/effect/decal/cleanable/dirt,
/turf/open/floor/carpet/red,
/area/ruin/unpowered/planet_battlefield/icwbase/hab)
