"qE" = (
/obj/structure/table/wood/poker,
/obj/item/stack/spacecash/c50,
/obj/item/lighter,
/obj/item/clothing/mask/cigarette/cigar,
/obj/item/toy/cards/deck/cas/black,
/obj/item/paper{
	default_raw_text = "03:29 / 24.11.505. Od tygodni nie widzieliśmy żadnego śladu statku. Od dawna klepiemy biedę. Statki, które się pojawiają, uciekają na nasz widok albo mają lepszą broń. Connie zginęła przy ostatnim napadzie, a statek, który obskoczyliśmy, też ledwo zipał. Cherry i Urna'rix chyba nie wyliżą się z ran z tamtego napadu. Riksi mówi, że jak nic się nie zmieni, racji i zapasów nie starczy do końca przyszłego miesiąca, a z naprawiania nowych części bazy musieliśmy zrezygnować. Cały materiał idzie już tylko na trzymanie w kupie tego, co mamy. Kit dostaje połowę moich racji, ale nie wiem, jak długo dam radę. Jestem od siły, a robię się za słaby, żeby się skupić. Potrzebujemy przełomu. Kończymy z patrolami i znowu tylko chowamy się na powierzchni, aż dostaniemy sygnał, że ktoś wchodzi. Mogę tylko, kurwa, mieć nadzieję.";
	pixel_x = -13;
	pixel_y = 9;
	name = "strona dziennika"
	},
/obj/effect/turf_decal/tile/red/half{
