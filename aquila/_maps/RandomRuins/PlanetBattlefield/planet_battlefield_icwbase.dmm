/obj/item/paper/crumpled/bloody{
	name = "zakrwawione bazgroły";
	pixel_x = -8;
	pixel_y = 3;
	default_raw_text = "Ta lista potencjalnych testerów służy na razie głównie do testów wstępnych, ale wszystkich łączy jedno: niska zdolność adaptacji komórek i wysokie ryzyko odrzucenia wszczepów. Oba problemy to oczywiście główne zmartwienie naszej firmy i klientów, ale dzięki bliskim współpracownikom, którzy zaskarbili sobie naszą wdzięczność, jesteśmy o krok od przełomu. Bioadaptacyjne protezy i wszczepy, które się hoduje, a nie produkuje, są coraz bliżej. Musimy tylko poczekać, aż koledzy zbiorą plony i, że tak powiem, „urodzą” gotowy produkt. Jaśniejsza przyszłość pod oboma słońcami, chyba."
	},
