/obj/machinery/firealarm/directional/east,
/obj/item/paper/crumpled{
	pixel_x = -5;
	pixel_y = 2;
	name = "aktualizacja";
	default_raw_text = "Kolejny atak pograniczników. Jesteśmy tu prawie osiem lat, a oni wciąż nie dają nam spokoju. Cieszę się chociaż, że broń daje radę. Wszyscy są ostatnio bardziej spięci. W sektorze jest coraz większy ruch. Powiedziałem miastu, że jeśli ktoś wyląduje, mają przygotować broń i zabić okna deskami, ale nie zaczynać zadymy, dopóki nie podejdą blisko. Mam nadzieję, że rozsądni ludzie zobaczą dobrze uzbrojone miasto i będą się trzymać z daleka, ale... muszę po prostu wierzyć, że to wystarczy."
	},
