/// Nazwy wyświetlane wartości: własne nazwy preferencji, a dla reszty polskie nazwy z list powyżej
/datum/preference/choiced/proc/get_display_names_with_polish()
	var/list/names = get_display_names()
	names = names ? names.Copy() : list()
	var/list/polish = GLOB.preference_display_names_pl[db_key]
	for(var/choice in get_choices())
		var/value = serialize(choice)
		if(!istext(value) || names[value]) // liczby (np. poziomy) nie mają nazw, a lista po liczbie szukałaby indeksu
			continue
		var/name = polish?[value] || GLOB.accessory_names_pl[value]
		if(name)
			names[value] = name
	return names
