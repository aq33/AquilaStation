/datum/dictionary_entry/spade
	title = "Niezawodna łopatka"
	body = "(Łopatką można podnosić rośliny. Użyj jej, by przenosić rośliny do tac, doniczek i maszyn.)\n\
	\n\
	// -- AUTOMATYCZNA TRANSKRYPCJA START -- INDEKS : 'HYDROPONIKA' -- REJESTR : \[UTAJNIONO\] -- //\n\
	\n\
	\[10:11:12\] 'Z tyłu jest więcej łopatek, na razie weź tę. Wykop roślinę z tacy albo doniczki i włóż ją do analizatora, tak jak ci pokazywałem.'\n\
	\n\
	\[10:11:22\] 'Którą?'\n\
	\n\
	\[10:11:26\] 'Już ci mówiłem, to bez znaczenia.'\n\
	\n\
	\[10:12:02\] 'I co teraz?'\n\
	\n\
	\[10:12:08\] 'Wyjmij ją z analizatora. Wywal gdziekolwiek, nieważne.'\n\
	\n\
	// -- AUTOMATYCZNA TRANSKRYPCJA KONIEC -- //\n\
	\n\
	(Łopatką można też usunąć podłoże z tacy albo wyczyścić z niej WSZYSTKIE rośliny.)"


/datum/dictionary_entry/trays
	title = "Pojemnik na glebę"
	body = "(Tace hydroponiczne mają wbudowane lampki kontrolne. Zielona oznacza, że roślina jest gotowa do zbioru, żółta, że roślina czegoś potrzebuje, a czerwona, że coś jej szkodzi. Zeskanuj tacę skanerem roślin, by dowiedzieć się więcej o lampkach.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Taca hydroponiczna ma 4 miejsca na rośliny i mieści 200u odczynników.)"

/datum/dictionary_entry/substrate
	title = "Worki ziemi"
	body = "(Worek z podłożem pozwala zmienić podłoże w tacy. Jakiego podłoża potrzebuje roślina, sprawdzisz, oglądając jej nasiona.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Podłoże można kupić w automacie albo wytworzyć w biogeneratorze.)"

/datum/dictionary_entry/seeder
	title = "Nasienne miejsce"
	body = "(Nasiona można wytwarzać i przechowywać w siewniku przemysłowym. Włóż do siewnika owoce albo całe rośliny, by uzyskać nasiona.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Ulepszony siewnik odzyskuje więcej nasion z owoców i roślin.)"

/datum/dictionary_entry/plant_scanner
	title = "W poszukiwaniu zagrożeń"
	body = "(Skaner roślin pozwala w biegu sprawdzić genetykę rośliny. Skan pokazuje też potrzeby rośliny.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Skanerem roślin można zeskanować tacę hydroponiczną, by dowiedzieć się, co oznaczają jej lampki.)"

/datum/dictionary_entry/analyzer
	title = "Przeanalizuj to"
	body = "(Analizator roślin pozwala zapisać części i cechy dojrzałej rośliny.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Cechy i części można zapisywać na dyskach danych roślin.)"

/datum/dictionary_entry/editor
	title = "Twoja nauka genetyczna"
	body = "(Sekwencer nasion pozwala edytować geny nasion, np. dodawać lub usuwać części i cechy.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Cechy i części można dodawać z dysków danych roślin.)"

/datum/dictionary_entry/kiln
	title = "Nie wchodź do pieca!"
	body = "(Piec radiacyjny pozwala zmutować części roślin w inne rodzaje.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Większość mutacji zatacza koło, ale niektóre mają rozgałęzione ścieżki.)"

/datum/dictionary_entry/mushrooms
	title = "Grzyb wśród n-"
	body = "(W przeciwieństwie do większości roślin grzyby można zbierać bez końca – ich plony się nie wyczerpują.)\n\
	\n\
	'Okaz pokrywał każdą powierzchnię ciasnego wnętrza. Gęsta mgła zarodników dusiła filtr maski, a mechaniczny jęk przeciął upiorną ciszę, której od tak dawna nic nie zakłócało.'\n\
	\n\
	(Grzyby mają najmniejsze łodygi i można je sadzić obok większości innych roślin.)"

/datum/dictionary_entry/parasites
	title = "Pasożyty"
	body = "(Małym roślinom, takim jak grzyby i kwiaty, można nadać pomocne cechy i sadzić je obok innych roślin, by te na tym korzystały.)\n\
	\n\
	Tu pojawi się historia.\n\
	\n\
	(Rośliny takie jak kwiaty mają wyjątkowe cechy, np. nektar, które czynią je cennym dodatkiem do ogrodu.)"

/datum/dictionary_entry/hallway
	title = "Ashley II"
	body = "(Rośliny pojawiające się na korytarzach zaczynają z losowymi dodatkowymi cechami.)\n\
	\n\
	\"Jezu, Chloe, to tylko pieprzona roślinka. O co ci chodzi?\"\n\
	\n\
	(Te cechy mogą być wyjątkowe i niespotykane nigdzie indziej.)"
