// AQUILA - Umysł z ciała: preferencja roli ducha kapłana przewodów

/datum/role_preference/midround_ghost/fleshmind_wire_priest
	name = "Kapłan przewodów"
	antag_datum = /datum/antagonist/fleshmind_wire_priest
	description = "Gdy okręt przelatuje przez anomalię grawitacyjną, na pokładzie może wykiełkować Umysł z ciała. Jako niewidzialne oko wybierasz miejsce na jego rdzeń, a potem rodzisz się przy nim jako kapłan przewodów i kierujesz rozrostem roju: sadzisz przewody, stawiasz struktury i wzywasz moby."
