///////////	Oldstation items

/obj/item/paper/fluff/ruins/oldstation
	name = "Alarm wybudzenia z kriostazy"
	default_raw_text = "<B>**OSTRZEŻENIE**</B><BR><BR>Stacja doznała katastrofalnych uszkodzeń. Sieć energetyczna wyczerpana, by obudzić załogę.<BR><BR>Cele natychmiastowe<br><br>1: Uruchom awaryjny generator<br>2: Znieś blokadę stacji na mostku<br><br>Szczegółowy raport sytuacyjny znajdziesz w „Raporcie o uszkodzeniach” na mostku."

/obj/item/paper/fluff/ruins/oldstation/damagereport
	name = "Raport o uszkodzeniach"
	default_raw_text = "<b>*Raport o uszkodzeniach*</b><br><br><b>Stacja Alfa</b> – zniszczona<br><br><b>Stacja Beta</b> – katastrofalne uszkodzenia. Medyczny – zniszczony. Atmosferyka – częściowo zniszczona. Rdzeń silnika – zniszczony.<br><br><b>Stacja Charlie</b> – nienaruszona. Utrata tlenu we wschodniej części głównego korytarza.<br><br><b>Stacja Delta</b> – nienaruszona. <b>OSTRZEŻENIE</b>: Stację Deltę zajmuje nieznana siła. Zamiary nieznane. Gatunek nieznany. Liczebność nieznana.<br><br>Zalecenie – przywrócić sieć energetyczną stacji za pomocą paneli słonecznych. Przywrócić system atmosferyczny stacji, by odzyskać powietrze."

/obj/item/paper/fluff/ruins/oldstation/protosuit
	name = "Raport o hardsuicie B01-RIG"
	default_raw_text = "<b>*Prototypowy hardsuit*</b><br><br>Hardsuit B01-RIG to prototypowy wspomagany egzoszkielet. Oparty na odzyskanym wojskowym egzoszkielecie wspomaganym zjednoczonego rządu Ziemi \
	sprzed wojny z pustką, hardsuit RIG jest przełomem w technologii hardsuitów i pierwszym hardsuitem z epoki po wojnie z pustką, którego operator może bezpiecznie używać.<br><br>B01 ma jednak \
	mnóstwo ograniczeń. Jest powolny i nieporęczny w ruchu, nie ma żadnego znaczącego opancerzenia chroniącego przed bezpośrednimi atakami, a jego wewnętrzny wyświetlacz HUD jest niedokończony,  \
	przez co użytkownik nie widzi na duże odległości.<br><br>B01 raczej nie trafi do masowej produkcji, ale posłuży jako baza do przyszłych prac nad hardsuitami."

/obj/item/paper/fluff/ruins/oldstation/protohealth
	name = "Raport o analizatorze zdrowia"
	default_raw_text = "<b>*Analizator zdrowia*</b><br><br>Przenośny analizator zdrowia to w zasadzie ręczna wersja analizatora zdrowia. Lata badań zaowocowały tym urządzeniem, które \
	potrafi zdiagnozować nawet najcięższe, najrzadsze i najbardziej techniczne obrażenia każdej istoty humanoidalnej w przystępnej formie, którą zrozumie nawet osoba bez przeszkolenia \
	medycznego.<br><br>Analizator zdrowia ma wejść do pełnej produkcji jako standardowe wyposażenie medyczne."

/obj/item/paper/fluff/ruins/oldstation/protogun
	name = "Raport o broni energetycznej K14"
	default_raw_text = "<b>*Wielofazowa broń energetyczna K14*</b><br><br>Prototypowa broń energetyczna K14 to pierwszy karabin energetyczny, który nie tylko mieści większy ładunek amunicji \
	niż inne modele, ale też bez żadnych incydentów przełącza się na rozkaz między różnymi rodzajami pocisków energetycznych.<br><br>Broń wciąż ma kilka wad: jej alternatywny, \
	nielaserowy tryb ognia wystrzeliwuje tylko jeden pocisk, zanim wyczerpie ogniwo energetyczne, a sama broń pozostaje zaporowo droga. Mimo to dział badań rynku NT jest przekonany, że ta broń \
	stanie się trzonem naszego katalogu broni energetycznej.<br><br>K14 ma przejść poprawki rozwiązujące problemy z amunicją, a K15 ma zastąpić tryb „ogłuszanie” trybem \
	„obezwładnianie”, by obejść problemy z amunicją."

/obj/item/paper/fluff/ruins/oldstation/protosing
	name = "Generator osobliwości"
	default_raw_text = "<b>*Generator osobliwości*</b><br><br>Współczesne wytwarzanie energii przybiera zwykle dwie formy: generator fuzyjny albo generator rozszczepieniowy. Fuzja daje najlepszy stosunek miejsca do mocy \
	i spotyka się ją zwykle na okrętach wojskowych oraz statkach i stacjach o wysokim poziomie bezpieczeństwa, jednak reaktory fuzyjne wymagają do budowy drogich i rzadkich materiałów. Generatory rozszczepieniowe są ogromne i nieporęczne, a do zasilania potrzebują dużego zapasu uranu, za to są niezwykle tanie w eksploatacji i po \
	uruchomieniu często wymagają niewielkiej konserwacji.<br><br>Osobliwość ma to zmienić. Działająca osobliwość to w zasadzie kontrolowana czarna dziura, która wytwarza znacznie więcej energii, niż generatory fuzyjne czy rozszczepieniowe \
	mogłyby kiedykolwiek wyprodukować. "

/obj/item/paper/fluff/ruins/oldstation/protoinv
	name = "Inwentarz laboratorium"
	default_raw_text = "<b>*Inwentarz*</b><br><br>(1) Prototypowy hardsuit<br><br>(1) Analizator zdrowia<br><br>(1) Prototypowa broń energetyczna<br><br>(1) Dysk generowania osobliwości<br><br><b>NIE ZABIERAĆ BEZ ZGODY KAPITANA I DYREKTORA BADAŃ</b>"

/obj/item/paper/fluff/ruins/oldstation/report
	name = "Raport o wybudzeniu załogi"
	default_raw_text = "Raport Sztucznego Programu dla ocalałych członków załogi.<br><br>Załogę umieszczono w kriostazie 10 marca 2445 roku.<br><br>Załogę wybudzono z kriostazy około czerwca 2557 roku.<br><br> \
	<b>ISTOTNE ZDARZENIA</b><br>1: Po 112 latach główne detektory promieniowania zostały wyłączone z powodu awarii zasilania, a zapasowe detektory nie wykazały na stacji resztkowego \
	promieniowania. Wniosek: główny detektor był uszkodzony i wykazywał promieniowanie, którego nie było.<br><br>2: Odebrano pakiet danych z pobliskiej stacji kosmicznej \
	Nanotrasen. Zawierał dane badawcze, które wgrano do naszych laboratoriów badawczo-rozwojowych.<br><br>3: Nieznane siły inwazyjne zajęły stację Delta."

/obj/item/paper/fluff/ruins/oldstation/generator_manual
	name = "instrukcja przenośnego generatora typu S.U.P.E.R.P.A.C.M.A.N."
	default_raw_text = "Ledwo rozróżniasz wyblakłe zdanie... <br><br> Przykręć generator na węźle przewodu podłączonym do terminala wejściowego SMES albo do sieci energetycznej."
