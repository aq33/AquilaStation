///////////	deepstorage items

/obj/item/paper/fluff/ruins/deepstorage/water_concern
	name = "uwagi w sprawie wody"
	default_raw_text = "Do tego, kto ciągle bierze długie, gorące prysznice: lecisz na następną wyprawę po lód. Jeśli czujesz potrzebę zużycia całej cholernej wody podczas swojego „odpoczynku”, to jak cholera na tę wodę zapracujesz!"

/obj/item/paper/fluff/ruins/deepstorage/hydro_notice
	name = "ogłoszenie hydroponiki"
	default_raw_text = "Hydroponika to tutaj nasze życie i krew; jeśli ona umrze, to my też. Podlewajcie te cholerne rośliny!"

/obj/item/paper/fluff/ruins/deepstorage/recycling_notice
	name = "ogłoszenie o recyklingu"
	default_raw_text = "Pamiętajcie, by wyrzucać wszystkie nadmiarowe odpady do zgniatarki z tyłu! To niesamowite, co da się wydobyć z tego, co inni uważają za „śmieci”, jeśli przepuści się to przez wielką zgniatarkę wystarczająco wiele razy."

